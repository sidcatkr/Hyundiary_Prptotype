<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 차량(AAOS) 전용 앱 -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- 차량 연동 권한: 실제로 부르는 API의 권한만 둔다(쓰지 않는 권한은 Pleos 심사 탈락 사유).
         CAR_SPEED, CAR_ENERGY(android.car), FUSED_LOCATION은 실행 중에 사용자 동의를 받는다. -->
    <!-- AAOS Car API -->
    <uses-permission android:name="android.car.permission.CAR_ENERGY" />     <!-- FUEL_LEVEL, RANGE_REMAINING -->
    <uses-permission android:name="android.car.permission.CAR_INFO" />       <!-- INFO_FUEL_CAPACITY, INFO_EV_BATTERY_CAPACITY -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />      <!-- PERF_VEHICLE_SPEED -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" /> <!-- GEAR_SELECTION -->
    <!-- Pleos Vehicle SDK -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />        <!-- Odometer, SteeringWheel -->
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />       <!-- EvBattery -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />       <!-- TurnSignal -->
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />        <!-- 안전벨트 -->
    <!-- Pleos NaviHelper / TextToSpeech / FusedLocation -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />        <!-- 목적지·주행 정보, 현재 위치 주소 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" /> <!-- 경유지 추가 -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />

    <!-- 화면은 APK 안의 파일만 쓰고 TTS는 ON_DEVICE 모드라 네트워크가 필요 없다.
         TextToSpeech SDK가 합쳐 넣는 INTERNET 권한을 뺀다. -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Hyundiary"
        android:usesCleartextTraffic="false"
        tools:targetApi="33">

        <!-- AAOS Car API 라이브러리. 없는 기기에서도 앱은 시연 데이터로 동작한다. -->
        <uses-library
            android:name="android.car"
            android:required="false" />

        <!-- landscape = Pleos에서 두 window를 합친 넓은 앱 창.
             창 크기·방향이 바뀌어도 WebView를 다시 만들지 않도록 configChanges를 직접 처리한다.
             distractionOptimized: 주행 중에도 앱을 띄우되, 주행 규제(CarUxRestrictions)가 켜지면
             웹 화면이 입력 없는 주행 화면으로 바뀌고 팝업·영상·입력 화면을 막는다. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|keyboard|keyboardHidden|navigation|layoutDirection|fontScale|locale"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
    </application>
</manifest>
