<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 차량(AAOS) 전용 앱 -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- 웹 목업은 APK 안의 파일만 쓰므로 INTERNET 권한을 두지 않는다 -->
    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Hyundiary"
        android:usesCleartextTraffic="false"
        tools:targetApi="33">

        <!-- landscape = Pleos에서 두 window를 합친 넓은 앱 창.
             창 크기·방향이 바뀌어도 WebView를 다시 만들지 않도록 configChanges를 직접 처리한다.
             목업은 정차 상태 시연용이라 distractionOptimized는 선언하지 않는다. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|keyboard|keyboardHidden|navigation|layoutDirection|fontScale|locale"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
